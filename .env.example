# Copy this file to ".env" and fill in the values from
# https://www.strava.com/settings/api  (create an app first).
#
# When creating the app, set "Authorization Callback Domain" to: localhost

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Filled in automatically by strava_auth.py after the one-time login.
STRAVA_REFRESH_TOKEN=
